{
  "format": "secretaria-backup-deployment-plan-v1",
  "applied": false,
  "provider": "Railway Hobby; separate cron service, pending approval",
  "rootDirectory": "/backend/backup",
  "dockerfile": "Dockerfile",
  "replicas": 1,
  "schedule": "0 */6 * * *",
