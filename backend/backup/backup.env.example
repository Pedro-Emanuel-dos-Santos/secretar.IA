# Preparation only. Do not copy the application's old .env. Never commit values.
BACKUP_MODE=real
BACKUP_APPROVAL_REFERENCE=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
# TLS verification with a trusted CA preferred; validate private-network TLS first.
PGSSLMODE=verify-full
PGSSLROOTCERT=
BACKUP_REDIS_HOST=
BACKUP_REDIS_PORT=6379
BACKUP_REDIS_USER=
REDISCLI_AUTH=
BACKUP_REDIS_TLS=yes
BACKUP_REDIS_CA_CERT=
BACKUP_REDIS_DEDICATED_INSTANCE_ACK=
# Verified source Redis memory limit (not the backup runner's memory).
BACKUP_REDIS_SOURCE_MEMORY_LIMIT_BYTES=
BACKUP_AGE_RECIPIENT=
# Private identity is NOT present in the capture runner.
BACKUP_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_HEALTHCHECK_URL=
# Proposed schedule: 0 */6 * * * UTC. Nothing is scheduled by this file.
