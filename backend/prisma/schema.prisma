generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model IncomingMessage {
  id                String   @id @default(uuid())
  providerMessageId String
  phoneNumberId     String
  phone             String
  text              String
  mediaId           String?
  mediaMimeType     String?
  transcribedAt     DateTime?
  status            String   @default("received")
  receivedAt        DateTime @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  reminder          Reminder?
  appointment       Appointment?
  knowledgeFact     KnowledgeFact?
  interpretation    Json?
  interpretationAttempts Int @default(0)
  executionAttempts Int @default(0)
  maxAttempts       Int @default(5)
  nextAttemptAt     DateTime @default(now())
  leaseToken        String?
  leaseUntil        DateTime?
  lastError         String?
  reply             ReplyOutbox?
  aiUsage AiUsage[]

  @@unique([phoneNumberId, providerMessageId])
  @@index([phoneNumberId, status, receivedAt])
  @@index([phoneNumberId, status, nextAttemptAt])
  @@index([phoneNumberId, phone, receivedAt])
}

model ContactPreference {
  phoneNumberId String
  phone String
  remindersPaused Boolean @default(false)
  pausedAt DateTime?
  timezone String @default("America/Sao_Paulo")
  displayName String?
  businessType String?
  onboardedAt DateTime?
  audioConsent Boolean @default(false)
  audioConsentAt DateTime?
  audioConsentProvider String?
  summaryEnabled Boolean @default(false)
  summaryTime String?
  updatedAt DateTime @updatedAt

  @@id([phoneNumberId, phone])
}

model ReplyOutbox {
  id                String   @id @default(uuid())
  messageId         String   @unique
  text              String
  refreshReminder   Boolean  @default(false)
  status            String   @default("pending")
  attempts          Int      @default(0)
  providerMessageId String?
  startedAt         DateTime?
  deliveryStatus    String?
  deliveryErrorCodes Json?
  deliveryUpdatedAt DateTime?
  finishedAt        DateTime?
  createdAt         DateTime @default(now())
  message           IncomingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model User {
  id        String   @id @default(uuid())
  name      String?
  phone     String   @unique
  timezone  String   @default("America/Sao_Paulo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders Reminder[]
  events Event[]
  appointments Appointment[]
  subjects BusinessSubject[]
}

model Reminder {
  id          String   @id @default(uuid())
  userId      String
  title       String
  kind String @default("task")
  digestKey String? @unique
  description String?
  remindAt    DateTime
  scheduleTimezone String @default("America/Sao_Paulo")
  status      String   @default("pending")
  state       String   @default("active")
  taskProgress String @default("pending")
  waitingFor String?
  progressUpdatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sourceMessageId   String? @unique
  deliveryStartedAt DateTime?
  providerMessageId String?
  scheduleVersion Int @default(0)
  seriesId String?
  occurrenceIndex Int?
  recurrenceFrequency String?
  recurrenceCount Int?
  deliveryStatus String?
  deliveryErrorCodes Json?
  deliveryUpdatedAt DateTime?
  appointmentId String?
  appointmentOffsetMinutes Float?
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceMessage IncomingMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: Restrict)
  scheduleOutbox ScheduleOutbox?
  @@index([userId, state, remindAt])
  @@index([userId, taskProgress, state])
  @@index([userId, createdAt])
  @@index([appointmentId])
  @@unique([seriesId, occurrenceIndex])
}

model AiUsage {
 id String @id @default(uuid())
 messageId String
 attempt Int
 provider String
 model String?
 inputTokens Int?
 outputTokens Int?
 cachedInputTokens Int?
 elapsedMs Int?
 outcome String @default("started")
 createdAt DateTime @default(now())
 message IncomingMessage @relation(fields:[messageId],references:[id],onDelete:Cascade)
 @@unique([messageId,attempt])
 @@index([createdAt])
}

model Appointment {
  id String @id @default(uuid())
  userId String
  phoneNumberId String
  subjectId String?
  title String
  description String?
  startsAt DateTime
  endsAt DateTime?
  state String @default("active")
  version Int @default(0)
  sourceMessageId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject BusinessSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  sourceMessage IncomingMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: Restrict)
  reminders Reminder[]
  @@index([userId, phoneNumberId, state, startsAt])
}

model BusinessSubject {
  id String @id @default(uuid())
  userId String
  phoneNumberId String
  kind String
  name String
  normalizedName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  facts KnowledgeFact[]
  appointments Appointment[]
  @@unique([userId, phoneNumberId, kind, normalizedName])
}

model KnowledgeFact {
  id String @id @default(uuid())
  subjectId String
  key String
  value String
  revision Int
  supersededAt DateTime?
  sourceMessageId String? @unique
  createdAt DateTime @default(now())
  subject BusinessSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sourceMessage IncomingMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: Restrict)
  @@unique([subjectId, key, revision])
  @@index([subjectId, supersededAt])
}

model ScheduleOutbox {
  id             String   @id @default(uuid())
  reminderId     String   @unique
  phoneNumberId  String
  status         String   @default("pending")
  attempts       Int      @default(0)
  maxAttempts    Int      @default(5)
  nextAttemptAt  DateTime @default(now())
  leaseToken     String?
  leaseUntil     DateTime?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reminder       Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId, status, nextAttemptAt])
}

model Event {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String

  source    String

  payload   Json

  createdAt DateTime @default(now())

  @@index([userId])

  @@index([type])

  @@index([createdAt])
}
