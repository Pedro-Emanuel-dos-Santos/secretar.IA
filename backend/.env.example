# Copy values into your private .env; never put real secrets in this example.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/secretaria_ia?schema=public
# Optional direct connection for Prisma CLI migrations; runtime keeps DATABASE_URL.
DIRECT_DATABASE_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_URL=https://graph.facebook.com/v23.0
# Token for the internal /reminders API; not sent by WhatsApp users.
ADMIN_API_TOKEN=
AI_MODE=hybrid
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional explicit recipient aliases; conversation identity is unchanged.
WHATSAPP_RECIPIENT_MAP={}
REDIS_HOST=localhost
REDIS_PORT=6379
# Managed Redis TCP/TLS URL, if present, takes precedence over REDIS_HOST/PORT.
REDIS_URL=
WHATSAPP_REMINDER_TEMPLATE_NAME=
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=pt_BR
# Set true only after Meta approval and a reviewed billing decision.
WHATSAPP_REMINDER_TEMPLATE_APPROVED=false
WHATSAPP_AUDIO_ENABLED=false
WHATSAPP_AUDIO_ALLOWED_PHONES=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AUDIO_TRANSCRIPTION_PROVIDER=local
LOCAL_WHISPER_PYTHON=
LOCAL_WHISPER_CACHE=
LOCAL_WHISPER_MODEL=base
REMINDER_MAX_LATENESS_MINUTES=60
REMINDER_MAX_ACTIVE_PER_USER=100
REMINDER_MAX_CREATED_PER_DAY=50
MAX_REQUESTS_PER_USER_PER_DAY=200
MAX_AUDIO_PER_USER_PER_DAY=20
