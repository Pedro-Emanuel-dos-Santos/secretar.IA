{
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.78.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "openai": "^6.45.0",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --import tsx --env-file=.env src/server.ts",
    "worker": "node --import tsx --env-file=.env src/queue/reminder.worker.ts",
    "test": "node test/run.cjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "worker:inbox": "node --import tsx --env-file=.env src/inbox-worker.ts",
    "test:integration": "node test/integration.cjs",
    "ops": "node --env-file=.env scripts/operations.cjs"
  }
}
