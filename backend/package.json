{
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^5.78.0",
    "cors": "^2.8.6",
    "dotenv": "18.0.8",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "openai": "^6.45.0",
    "prisma": "7.10.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env --env-file-if-exists=.env src/server.ts",
    "start": "node --import tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/server.ts",
    "worker": "node --import tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/queue/reminder.worker.ts",
    "test": "node test/run.cjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "db:generate": "node --env-file-if-exists=../.env --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=../.env --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "worker:inbox": "node --import tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/inbox-worker.ts",
    "test:integration": "node test/integration.cjs",
    "ops": "node --env-file-if-exists=../.env --env-file-if-exists=.env scripts/operations.cjs",
    "start:compiled": "node --env-file-if-exists=../.env --env-file-if-exists=.env dist/server.js",
    "check:pilot": "node --env-file-if-exists=../.env --env-file-if-exists=.env scripts/check-pilot.cjs"
  },
  "engines": {
    "node": "24.x"
  }
}
