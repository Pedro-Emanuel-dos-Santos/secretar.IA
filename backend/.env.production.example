# Copy privately to repository root as .env.production. Never commit that file.
POSTGRES_USER=secretaria
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=secretaria_ia
# URL-encode the same password in this URL. Host/port are internal to Docker.
DATABASE_URL=postgresql://secretaria:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/secretaria_ia?schema=public
DIRECT_DATABASE_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=
WHATSAPP_API_URL=https://graph.facebook.com/v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_RECIPIENT_MAP={}
WHATSAPP_REMINDER_TEMPLATE_NAME=
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_REMINDER_TEMPLATE_APPROVED=false
ADMIN_API_TOKEN=
AI_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WHATSAPP_AUDIO_ENABLED=false
WHATSAPP_AUDIO_ALLOWED_PHONES=
AUDIO_TRANSCRIPTION_PROVIDER=local
# Only enable local audio on the optional inbox audio image, with a measured budget.
LOCAL_WHISPER_PYTHON=/usr/local/bin/python
LOCAL_WHISPER_CACHE=/models
LOCAL_WHISPER_MODEL=base
REMINDER_MAX_LATENESS_MINUTES=60
REMINDER_MAX_ACTIVE_PER_USER=100
REMINDER_MAX_CREATED_PER_DAY=50
MAX_REQUESTS_PER_USER_PER_DAY=200
MAX_AUDIO_PER_USER_PER_DAY=20
